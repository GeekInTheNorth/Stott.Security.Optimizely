# Copy this file to .env (gitignored) and fill in the values.
# An admin user must already exist in the Sample CMS — see README.md for first-run admin registration.

CMS_USERNAME=
CMS_PASSWORD=

# URLs the tests drive. Override only if you've changed the Kestrel port bindings in
# Sample/OptimizelyTwelveTest/Program.cs.
APP_ONE_FRONTEND_URL=https://localhost:5000
APP_ONE_CMS_URL=https://localhost:5001
APP_TWO_URL=https://localhost:5002
